*{
margin:0;
padding:0;
box-sizing:border-box;
scroll-behavior:smooth;
}

:root{

--bg:#050505;
--card:#111111;
--card2:#191919;

--orange:#ff7b00;
--orange2:#ff5100;

--white:#ffffff;
--gray:#bcbcbc;

}

body{

font-family:'Poppins',sans-serif;

background:linear-gradient(180deg,#050505,#0b0b0b,#101010);

color:white;

overflow-x:hidden;

}

body::-webkit-scrollbar{

width:10px;

}

body::-webkit-scrollbar-thumb{

background:var(--orange);

border-radius:20px;

}

.blur{

position:fixed;

width:450px;

height:450px;

border-radius:50%;

filter:blur(170px);

opacity:.22;

z-index:-1;

}

.blur1{

top:-120px;

left:-100px;

background:orange;

}

.blur2{

right:-150px;

bottom:-120px;

background:#ff3c00;

}

header{

position:fixed;

width:100%;

top:0;

left:0;

z-index:999;

backdrop-filter:blur(20px);

background:rgba(0,0,0,.45);

border-bottom:1px solid rgba(255,255,255,.06);

}

nav{

max-width:1400px;

margin:auto;

display:flex;

justify-content:space-between;

align-items:center;

padding:22px 40px;

}

.logo{

font-size:30px;

font-weight:800;

letter-spacing:2px;

}

.logo span{

color:var(--orange);

}

nav ul{

display:flex;

gap:45px;

list-style:none;

}

nav a{

color:white;

text-decoration:none;

transition:.35s;

font-weight:500;

}

nav a:hover{

color:var(--orange);

}

.nav-btn{

padding:14px 28px;

background:linear-gradient(135deg,var(--orange),var(--orange2));

border-radius:40px;

font-weight:700;

box-shadow:0 15px 40px rgba(255,120,0,.35);

}

.hero{

min-height:100vh;

display:grid;

grid-template-columns:1.1fr 1fr;

align-items:center;

padding:130px 8%;

gap:80px;

}

.tag{

display:inline-block;

padding:10px 20px;

border:1px solid rgba(255,255,255,.08);

background:rgba(255,255,255,.04);

border-radius:30px;

color:#ffd2a4;

margin-bottom:25px;

font-size:14px;

letter-spacing:2px;

}

.hero h1{

font-size:78px;

line-height:84px;

font-weight:800;

margin-bottom:30px;

}

.hero h1 span{

color:var(--orange);

}

.hero p{

font-size:20px;

line-height:38px;

color:var(--gray);

max-width:650px;

}

.hero-buttons{

display:flex;

gap:25px;

margin-top:45px;

flex-wrap:wrap;

}

.btn{

padding:18px 36px;

background:linear-gradient(135deg,var(--orange),var(--orange2));

border-radius:45px;

color:white;

text-decoration:none;

font-weight:700;

transition:.35s;

box-shadow:0 20px 40px rgba(255,110,0,.3);

}

.btn:hover{

transform:translateY(-6px);

}

.btn2{

padding:18px 36px;

border-radius:45px;

border:1px solid rgba(255,255,255,.15);

color:white;

text-decoration:none;

transition:.35s;

}

.btn2:hover{

background:white;

color:black;

}

.hero-right{

display:flex;

justify-content:center;

}

.hero-right img{

width:100%;

max-width:520px;

border-radius:30px;

box-shadow:0 35px 80px rgba(0,0,0,.65);

transition:.5s;

}

.hero-right img:hover{

transform:scale(1.03);

}

section{

padding:110px 8%;

}

.section-title{

text-align:center;

margin-bottom:70px;

}

.section-title h2{

font-size:54px;

font-weight:800;

margin-bottom:15px;

}

.section-title p{

color:var(--gray);

font-size:18px;

}
.about-grid{

display:grid;

grid-template-columns:1fr 1fr;

gap:70px;

align-items:center;

}

.about-grid h3{

font-size:38px;

margin-bottom:25px;

color:var(--orange);

}

.about-grid p{

font-size:18px;

line-height:38px;

color:var(--gray);

}

.gallery{

display:grid;

grid-template-columns:repeat(2,1fr);

gap:20px;

}

.gallery img{

width:100%;

height:280px;

object-fit:cover;

border-radius:22px;

transition:.45s;

box-shadow:0 20px 50px rgba(0,0,0,.35);

cursor:pointer;

}

.gallery img:hover{

transform:translateY(-10px) scale(1.04);

box-shadow:0 35px 80px rgba(255,123,0,.25);

}

.numbers{

display:grid;

grid-template-columns:repeat(4,1fr);

gap:30px;

padding:80px 8%;

}

.numbers div{

background:linear-gradient(180deg,#141414,#0d0d0d);

border:1px solid rgba(255,255,255,.08);

border-radius:24px;

padding:40px;

text-align:center;

transition:.4s;

}

.numbers div:hover{

transform:translateY(-12px);

border-color:rgba(255,123,0,.45);

}

.numbers h2{

font-size:52px;

color:var(--orange);

margin-bottom:10px;

}

.numbers p{

font-size:18px;

color:var(--gray);

}

.cards{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(300px,1fr));

gap:35px;

}

.card{

background:linear-gradient(180deg,#171717,#0d0d0d);

border-radius:30px;

padding:40px;

border:1px solid rgba(255,255,255,.08);

transition:.45s;

position:relative;

overflow:hidden;

}

.card::before{

content:"";

position:absolute;

top:0;

left:0;

width:100%;

height:4px;

background:linear-gradient(90deg,var(--orange),var(--orange2));

transform:scaleX(0);

transition:.4s;

}

.card:hover::before{

transform:scaleX(1);

}

.card:hover{

transform:translateY(-14px);

box-shadow:0 30px 70px rgba(255,123,0,.18);

}

.card h3{

font-size:30px;

margin-bottom:20px;

color:white;

}

.card p{

color:var(--gray);

line-height:34px;

font-size:17px;

}

.video{

max-width:1100px;

margin:auto;

border-radius:30px;

overflow:hidden;

box-shadow:0 40px 90px rgba(0,0,0,.45);

}

.video iframe{

width:100%;

height:620px;

border:none;

display:block;

}
.premium{

max-width:1200px;

margin:auto;

padding:70px;

border-radius:35px;

background:linear-gradient(180deg,#151515,#090909);

border:1px solid rgba(255,255,255,.08);

box-shadow:0 40px 100px rgba(0,0,0,.45);

text-align:center;

}

.premium h2{

font-size:56px;

margin-bottom:20px;

font-weight:800;

}

.premium>p{

font-size:20px;

color:var(--gray);

margin-bottom:45px;

}

.benefits{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(260px,1fr));

gap:22px;

margin:45px 0;

}

.benefits div{

background:#141414;

padding:22px;

border-radius:18px;

border:1px solid rgba(255,255,255,.08);

font-size:18px;

transition:.35s;

}

.benefits div:hover{

transform:translateY(-8px);

border-color:rgba(255,123,0,.45);

background:#1a1a1a;

}

.buttons{

display:flex;

justify-content:center;

gap:25px;

flex-wrap:wrap;

margin-top:45px;

}

.buttons a{

padding:18px 34px;

text-decoration:none;

font-weight:700;

border-radius:40px;

background:linear-gradient(135deg,var(--orange),var(--orange2));

color:white;

transition:.35s;

box-shadow:0 18px 40px rgba(255,123,0,.25);

}

.buttons a:hover{

transform:translateY(-6px);

}

button{

margin-top:35px;

padding:18px 40px;

background:transparent;

border:2px solid var(--orange);

color:white;

font-size:17px;

font-weight:700;

border-radius:40px;

cursor:pointer;

transition:.35s;

}

button:hover{

background:var(--orange);

transform:translateY(-6px);

}

footer{

padding:60px 20px;

text-align:center;

color:#8f8f8f;

font-size:15px;

border-top:1px solid rgba(255,255,255,.06);

margin-top:80px;

}

@keyframes fadeUp{

from{

opacity:0;

transform:translateY(60px);

}

to{

opacity:1;

transform:translateY(0);

}

}

.hero,

.about-grid,

.cards,

.numbers,

.video,

.premium{

animation:fadeUp 1s ease;

}

@media(max-width:1100px){

.hero{

grid-template-columns:1fr;

text-align:center;

}

.hero-right{

margin-top:40px;

}

.hero p{

margin:auto;

}

.hero-buttons{

justify-content:center;

}

.about-grid{

grid-template-columns:1fr;

}

.gallery{

grid-template-columns:repeat(2,1fr);

}

.numbers{

grid-template-columns:repeat(2,1fr);

}

.hero h1{

font-size:60px;

line-height:65px;

}

.video iframe{

height:420px;

}

}

@media(max-width:700px){

nav{

padding:18px 20px;

}

nav ul{

display:none;

}

.hero{

padding:120px 25px;

}

.hero h1{

font-size:42px;

line-height:48px;

}

.section-title h2{

font-size:36px;

}

.gallery{

grid-template-columns:1fr;

}

.numbers{

grid-template-columns:1fr;

}

.cards{

grid-template-columns:1fr;

}

.premium{

padding:40px 25px;

}

.video iframe{

height:250px;

}

.buttons{

flex-direction:column;

}

.buttons a{

width:100%;

}

button{

width:100%;

}

}
